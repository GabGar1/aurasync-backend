{
  "name": "aurasync-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 src/**/*.test.ts",
    "pretest": "NODE_ENV=test node --import tsx src/test/bootstrap.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:make": "node --import tsx ./node_modules/knex/bin/cli.js migrate:make -x ts",
    "db:migrate": "node --import tsx ./node_modules/knex/bin/cli.js migrate:latest",
    "db:rollback": "node --import tsx ./node_modules/knex/bin/cli.js migrate:rollback",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:seed": "node --import tsx src/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "knex": "^3.2.5",
    "pg": "^8.20.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.5.11",
    "eslint": "^9.39.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
