PORT=3333
HOST=127.0.0.1
JWT_SECRET=change-me-to-a-random-secret
CSRF_SECRET=change-me-to-another-random-secret

DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/aurasync
# Optional: dedicated database for integration tests (created automatically by `npm test`).
# Defaults to postgresql://admin:admin@127.0.0.1:5433/aurasync_test when unset.
DATABASE_URL_TEST=postgresql://admin:admin@127.0.0.1:5433/aurasync_test

NUVEMSHOP_STORE_ID=your-store-id
NUVEMSHOP_ACCESS_TOKEN=your-nuvemshop-access-token
NUVEMSHOP_WEBHOOK_SECRET=your-webhook-secret

DB_SEED_EMAIL=admin@aurasync.com
DB_SEED_PASSWORD=change-me-to-a-strong-password

POSTGRES_DB=aurasync
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Security / deployment
NODE_ENV=development
TRUST_PROXY=false
# Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS=
